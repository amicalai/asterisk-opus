;
; The 'opus' section configures Opus codec-specific options.
;
[opus]
; Complexity affects encoding quality and CPU usage
; Values range from 0 to 10 (low complexity to high quality)
; Default: 10
complexity=10

; Maximum average bitrate (bits per second)
; Values range from 500 to 512000, or 'auto'
; Common values: 8000 (low quality), 16000 (medium), 32000 (high)
; Default: 510000 ('auto')
bitrate=510000

; Forward Error Correction for improved audio quality on lossy networks
; Values: yes / no
; Default: yes
fec=yes

; Discontinuous Transmission (DTX) for reduced bandwidth during silence
; Values: yes / no
; Default: no
dtx=no

; Constant Bitrate Mode (CBR) instead of Variable Bitrate Mode (VBR)
; Values: yes / no
; Default: no (VBR is used by default)
cbr=no

; Maximum playback rate limits the audio bandwidth used
; Values: 8000, 12000, 16000, 24000, 48000 (Hz)
; Default: 48000
max_playback_rate=48000

; Packet Loss Percentage Estimation
; Dynamically enables FEC based on estimated packet loss
; Values: -1 (disabled), 0-100 (percent)
; Default: -1 (disabled)
; Note: Setting to 0 forces FEC for all packets regardless of loss
packet_loss=-1

; Maximum bandwidth determines the audio frequency range limit
; Values: narrow, medium, wide, super_wide, full
; Default: full
max_bandwidth=full

; Signal type hint for the encoder
; Values: auto, voice, music
; Default: auto
signal=auto

; Application type for encoder optimization
; Values: voip, audio, low_delay
; Default: voip
application=voip

; Example of complete configuration:
; 
; [opus]
; complexity=8             ; Medium CPU usage
; max_average_bitrate=20000  ; 20 kbit/s average
; max_playback_rate=48000  ; Super wideband quality
; cbr=no                   ; Use variable bitrate
; fec=yes                  ; Use forward error correction
; dtx=no                   ; Don't use discontinuous transmission
; packet_loss=15           ; Estimate 15% packet loss
; max_bandwidth=super_wide ; Super wideband quality
; signal=voice             ; Optimize for voice
; application=voip         ; Optimize for VoIP
;
; Note: Configuration changes only apply to new encoding/decoding sessions.
; Existing sessions will continue using their original settings.
