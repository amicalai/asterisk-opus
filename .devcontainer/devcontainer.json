{
	"name": "asterisk-opus",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "../",
		"options": [
			"--add-host=host.docker.internal:host-gateway"
		]
	},
	"mounts": [
		{
			"source": "${localWorkspaceFolder}/codecs.conf.sample",
			"target": "/etc/asterisk/codecs.conf",
			"type": "bind"
		}
	],
	"appPort": [
		"5060:5060/udp",
		"5060:5060/tcp",
		"5061:5061/tcp",
		"10000-10010:10000-10010/udp",
		"8088:8088/tcp"
	],
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools"
			],
			"settings": {
				"dev.containers.copyGitConfig": true,
				"C_Cpp.default.includePath": [
					"${workspaceFolder}/**",
					"/usr/src/asterisk/include",
					"/usr/include"
				],
				"C_Cpp.default.compilerPath": "/usr/bin/gcc",
				"C_Cpp.default.cStandard": "c11"
			}
		}
	},
	"remoteUser": "vscode"
}
