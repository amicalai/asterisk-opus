# syntax=docker/dockerfile:1
#
# Asterisk Opus DevContainer - Alpine Linux (musl)
#
# Use by setting "dockerfile": "Dockerfile.alpine" in devcontainer.json
#

ARG ALPINE_VERSION=3.22
ARG ASTERISK_VERSION=23.1.0

# ------------------------------------------------------------
# BASE IMAGE PREPARATION
# ------------------------------------------------------------

FROM alpine:${ALPINE_VERSION} AS base

ARG ALPINE_VERSION
ARG ASTERISK_VERSION

LABEL maintainer="Yoann Vanitou <yoann@amical-ai.com>"
LABEL org.opencontainers.image.authors="Amical, Yoann Vanitou <yoann@amical-ai.com>"
LABEL org.opencontainers.image.source="https://github.com/amicalai/asterisk-opus"
LABEL org.opencontainers.image.description="Asterisk Opus codec development environment"
LABEL org.opencontainers.image.licenses="MIT"
LABEL version="${ASTERISK_VERSION}"

# Runtime + build dependencies (needed for recompilation in dev)
RUN --mount=type=cache,target=/var/cache/apk \
    apk update && apk upgrade && \
    apk add --no-cache \
    alsa-lib \
    ffmpeg \
    freetds \
    jansson \
    libcurl \
    libedit \
    libltdl \
    libogg \
    libsrtp \
    libstdc++ \
    libuuid \
    libvorbis \
    libxml2 \
    lua5.2 \
    lua5.2-dev \
    ncurses \
    opus \
    opus-dev \
    opus-tools \
    libopusenc \
    libopusenc-dev \
    opusfile \
    opusfile-dev \
    popt \
    portaudio \
    speex \
    speexdsp \
    sqlite \
    sqlite-dev \
    vorbis-tools \
    zlib \
    pjproject \
    g++ \
    gcc \
    make \
    patch \
    bison \
    flex \
    curl \
    curl-dev \
    tar \
    openssl-dev \
    libxml2-dev \
    speex-dev \
    speexdsp-dev \
    freetds-dev \
    libvorbis-dev \
    popt-dev \
    portaudio-dev \
    db-dev \
    libsrtp-dev \
    autoconf \
    automake \
    jansson-dev \
    libtool \
    pjproject-dev \
    newt-dev \
    zlib-dev \
    bsd-compat-headers \
    xmlstarlet \
    libedit-dev \
    util-linux-dev \
    linux-headers \
    gdb \
    valgrind

# ------------------------------------------------------------
# BUILDER IMAGE PREPARATION
# ------------------------------------------------------------

FROM base AS builder

ARG ALPINE_VERSION
ARG ASTERISK_VERSION

RUN apk add --no-cache git

WORKDIR /usr/src

# Clone Asterisk
RUN --mount=type=cache,target=/root/.cache/git \
    git clone --depth 1 --branch ${ASTERISK_VERSION} https://github.com/asterisk/asterisk.git asterisk

# Copy local Opus module sources
COPY include/asterisk/ asterisk/include/asterisk/
COPY codecs/ asterisk/codecs/
COPY res/ asterisk/res/

WORKDIR /usr/src/asterisk

# Alpine/musl compatibility patches
RUN sed -i '/#include <unistd.h>/a #include <pthread.h>' include/asterisk/compat.h && \
    sed -i 's/#if (defined(SOLARIS) || defined(BSD))/#if (defined(SOLARIS) || defined(BSD) || !defined(HAVE_PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP))/' include/asterisk/lock.h && \
    echo '#ifndef ALLPERMS' > /tmp/allperms.patch && \
    echo '#   define ALLPERMS (S_ISUID|S_ISGID|S_ISVTX|S_IRWXU|S_IRWXG|S_IRWXO)' >> /tmp/allperms.patch && \
    echo '#endif' >> /tmp/allperms.patch && \
    sed -i '/#define RSA_PKCS1_OAEP_PADDING_SIZE/r /tmp/allperms.patch' res/res_crypto.c && \
    sed -i '1s/^/#include <libgen.h>\n/' res/res_http_post.c && \
    sed -i '1i #ifndef __P\n#define __P(x) x\n#endif' main/ast_expr2.c

RUN ./bootstrap.sh && \
    CFLAGS="-ggdb -O0 -fno-omit-frame-pointer -fstack-protector-all -Wno-error" \
    ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --mandir=/usr/share/man \
    --libdir=/usr/lib \
    --localstatedir=/var \
    --disable-xmldoc \
    --enable-permanent-dlopen \
    --enable-dev-mode \
    --with-gsm=internal \
    --with-popt \
    --with-z \
    --with-newt \
    --with-sqlite3 \
    --with-speex \
    --without-dahdi \
    --without-pri \
    --without-tonezone \
    --without-x11 \
    --without-pjproject-bundled \
    --with-libcurl \
    --with-libedit \
    --with-srtp \
    --with-opus

RUN make menuselect.makeopts && \
    menuselect/menuselect \
    --disable BUILD_NATIVE \
    --disable DONT_OPTIMIZE \
    --disable CORE-SOUNDS-EN-GSM \
    --disable app_voicemail \
    --enable BETTER_BACKTRACES \
    --enable codec_opus_open_source \
    --enable CORE-SOUNDS-EN-WAV \
    --enable CORE-SOUNDS-FR-WAV \
    --enable res_format_attr_opus \
    --enable res_http_post \
    --enable res_http_websocket \
    --enable res_pjproject \
    --enable res_pjsip \
    --enable res_pjsip_session \
    --enable res_rtp_asterisk \
    --enable res_stasis \
    --enable app_stasis \
    --enable res_timing_timerfd \
    menuselect.makeopts

RUN make -j$(nproc) && \
    make install && \
    make basic-pbx

# ------------------------------------------------------------
# FINAL DEV IMAGE
# ------------------------------------------------------------

FROM mcr.microsoft.com/devcontainers/base:alpine-${ALPINE_VERSION}

ARG ALPINE_VERSION
ARG ASTERISK_VERSION

RUN apk add --no-cache \
    alsa-lib \
    ffmpeg \
    freetds \
    jansson \
    libcurl \
    libedit \
    libltdl \
    libogg \
    libsrtp \
    libstdc++ \
    libuuid \
    libvorbis \
    libxml2 \
    lua5.2 \
    lua5.2-dev \
    ncurses \
    opus \
    opus-dev \
    opus-tools \
    libopusenc \
    libopusenc-dev \
    opusfile \
    opusfile-dev \
    popt \
    portaudio \
    speex \
    speexdsp \
    sqlite \
    sqlite-dev \
    vorbis-tools \
    zlib \
    pjproject \
    g++ \
    gcc \
    make \
    autoconf \
    automake \
    libtool \
    curl-dev \
    openssl-dev \
    libxml2-dev \
    speex-dev \
    speexdsp-dev \
    freetds-dev \
    libvorbis-dev \
    popt-dev \
    portaudio-dev \
    db-dev \
    libsrtp-dev \
    jansson-dev \
    pjproject-dev \
    newt-dev \
    zlib-dev \
    libedit-dev \
    util-linux-dev \
    linux-headers \
    bsd-compat-headers \
    gdb \
    valgrind \
    compiler-rt

COPY --link --chmod=755 --from=builder /usr/sbin/asterisk /usr/sbin/
COPY --link --chmod=755 --from=builder /usr/sbin/astcanary /usr/sbin/
COPY --link --from=builder /usr/lib/asterisk /usr/lib/asterisk
COPY --link --from=builder /usr/lib/libasterisk* /usr/lib/
COPY --link --chmod=644 --from=builder /etc/asterisk /etc/asterisk
COPY --link --chown=vscode:vscode --chmod=755 --from=builder /var/spool/asterisk /var/spool/asterisk
COPY --link --chown=vscode:vscode --chmod=755 --from=builder /var/run/asterisk /var/run/asterisk
COPY --link --chown=vscode:vscode --chmod=755 --from=builder /var/lib/asterisk /var/lib/asterisk
COPY --link --from=builder /usr/src/asterisk /usr/src/asterisk

RUN mkdir -p /var/log/asterisk && \
    chown -R vscode:vscode /var/log/asterisk && \
    chmod 755 /var/log/asterisk

RUN ln -sf /usr/lib/lua5.2/liblua-5.2.so.0.0.0 /usr/lib/liblua.so && \
    ln -sf /usr/lib/lua5.2/liblua-5.2.so.0.0.0 /usr/lib/liblua.so.5o.5

WORKDIR /workspaces/asterisk-opus
